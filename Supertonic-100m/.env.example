# Groq API key - get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the Groq model used for replies.
# See https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-20b

# Remote Whisper avoids the incorrect empty transcripts produced by concurrent
# Moonshine batches on the CPU-only deployment.
STT_PROVIDER=groq
