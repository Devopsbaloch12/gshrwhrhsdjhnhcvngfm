# Groq API key - get one at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Optional: override the Groq model used for replies.
# See https://console.groq.com/docs/models for the current list.
GROQ_MODEL=openai/gpt-oss-20b

# moonshine (local) or groq (remote Whisper). Local Moonshine is the default here:
# its thread count is tunable, which took STT from 0.61s to 0.34s per turn, and the
# empty-transcript problem that motivated the remote path did not reproduce on a
# 16-vCPU host (0 empty and 0 wrong transcripts across runs at 8/15/30 concurrent).
STT_PROVIDER=moonshine
